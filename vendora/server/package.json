{
  "name": "@vendora/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=../.env dist/index.js",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "retention": "tsx --env-file-if-exists=../.env src/jobs/retention.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.2.0",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.7",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@vendora/shared": "*",
    "archiver": "^8.0.0",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.7",
    "ipaddr.js": "^2.5.0",
    "pg": "^8.16.0",
    "prisma": "^7.10.1",
    "robots-parser": "^3.0.1",
    "sharp": "^0.35.5",
    "undici": "^8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "*",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
