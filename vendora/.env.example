# ─── Obrigatórias ─────────────────────────────────────────────
DATABASE_URL=postgresql://vendora:vendora@localhost:5432/vendora
# 32 bytes em hex (64 caracteres). Gere com: openssl rand -hex 32
# Cifra os tokens OAuth dos marketplaces e assina as URLs das imagens.
TOKEN_ENCRYPTION_KEY=

# URL pública da aplicação (front e API na mesma origem).
APP_URL=http://localhost:5173

# ─── IA (opcional; sem chave usa o gerador básico, sem reescrita) ───
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium

# ─── Extração de páginas ─────────────────────────────────────
FETCH_TIMEOUT_MS=10000
FETCH_MAX_BYTES=3145728
FETCH_USER_AGENT=VendoraBot/0.1 (+https://SEU-DOMINIO/bot)
# Só desligue com autorização expressa do site.
RESPECT_ROBOTS_TXT=true

# ─── Imagens e armazenamento ─────────────────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
# Para S3 / R2 / MinIO (bucket privado):
# STORAGE_DRIVER=s3
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
IMAGE_MAX_BYTES=15728640
# Imagens de análises que não viraram anúncio são apagadas após N dias.
ASSET_RETENTION_DAYS=30
# Remoção de fundo (opcional): https://www.remove.bg/api
REMOVE_BG_API_KEY=

# ─── Mercado Livre (opcional) ────────────────────────────────
# App criado em https://developers.mercadolivre.com.br/devcenter
# Redirect URI cadastrada no app: APP_URL/api/integrations/mercado_livre/callback
ML_CLIENT_ID=
ML_CLIENT_SECRET=

# ─── Servidor ────────────────────────────────────────────────
PORT=3001
# Em produção, o servidor também entrega o front-end compilado:
# WEB_DIST_DIR=../web/dist
# COOKIE_SECURE=true
RATE_LIMIT_PER_MINUTE=120
ANALYZE_LIMIT_PER_HOUR=60

# ─── Testes ──────────────────────────────────────────────────
# Banco separado: a suíte apaga os dados dele a cada execução.
TEST_DATABASE_URL=postgresql://vendora:vendora@localhost:5432/vendora_test
