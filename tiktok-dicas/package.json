    "@remotion/transitions": "^4.0.536",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "remotion": "^4.0.536"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
