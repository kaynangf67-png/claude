# ---------------------------------------------------------------------------
# FRONTEND (públicas — vão para o navegador). Nunca coloque segredos em VITE_*.
# ---------------------------------------------------------------------------
# Sem estas duas, o app roda em "modo local" (dados só neste navegador, sem login).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# BACKEND (somente servidor — configure no provedor, ex.: Vercel → Environment Variables)
# ---------------------------------------------------------------------------
# Google Trends via SerpApi (https://serpapi.com). A API oficial do Google Trends está em alpha fechado.
SERPAPI_KEY=

# Mercado Livre (https://developers.mercadolivre.com.br) — app criado no DevCenter.
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Refresh token obtido no fluxo authorization_code (é rotacionado a cada uso; ver README).
ML_REFRESH_TOKEN=
# Alternativa para testes rápidos: access token direto (expira em ~6h).
ML_ACCESS_TOKEN=

# Shopee Affiliate Open API (programa de afiliados Shopee Brasil).
SHOPEE_AFFILIATE_APP_ID=
SHOPEE_AFFILIATE_SECRET=

# Persistência do backend (sincronização agendada). NUNCA exponha no frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Protege /api/sync (a Vercel envia "Authorization: Bearer $CRON_SECRET" no cron).
CRON_SECRET=
# Termos monitorados pela sincronização agendada (separados por vírgula).
SYNC_TERMS=mini liquidificador portátil,seladora a vácuo,acessórios para pets
