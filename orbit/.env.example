# ---------------------------------------------------------------------------
# ORBIT — variáveis de ambiente. Copie para .env.local e preencha.
# Nunca commite valores reais. Variáveis NEXT_PUBLIC_* vão para o navegador.
# ---------------------------------------------------------------------------

# URL pública da aplicação (usada em links de e-mail e no OAuth do Google)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (obrigatório) — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente servidor. Nunca exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Provedor de IA (opcional). Sem chave, planos são manuais e a classificação fica indisponível.
ORBIT_AI_PROVIDER=anthropic
ORBIT_AI_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=

# Criptografia de credenciais de integrações: 32 bytes em base64
#   openssl rand -base64 32
ORBIT_ENCRYPTION_KEY=

# Gmail via OAuth do Google (opcional)
# Redirect URI autorizado: ${NEXT_PUBLIC_APP_URL}/api/integrations/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Protege /api/cron/tick (retomada de missões em segundo plano). Mínimo 16 caracteres.
CRON_SECRET=
