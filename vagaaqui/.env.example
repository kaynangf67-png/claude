# VagaAqui — variáveis de ambiente (todas opcionais)
# Copie para .env.local e preencha. Nunca faça commit de .env.local.

# URL do backend real. Se vazio, o app usa o repositório mock local.
VITE_API_URL=

# Centro do mapa (lat/lon) e raio da área baixada do OpenStreetMap.
VITE_MAP_CENTER_LAT=-20.3290
VITE_MAP_CENTER_LON=-40.2920
VITE_OSM_RADIUS_M=650

# "osm" (padrão): ruas reais do OpenStreetMap. "procedural": cidade fictícia de demonstração.
VITE_MAP_SOURCE=osm

# "true" liga o GPS contínuo ao abrir o mapa (também há a opção em Configurações).
# Fora da área de demonstração o app volta para a localização simulada.
VITE_USE_BROWSER_GPS=false

# Sensor de câmera (protótipo). Por padrão o modelo vem do Google Storage (MediaPipe)
# e o WebAssembly é servido pelo próprio app em /mediapipe-wasm.
VITE_DETECTOR_MODEL_URL=
VITE_MEDIAPIPE_WASM_URL=
