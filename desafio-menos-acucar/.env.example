# Desafio Menos Açúcar — variáveis de ambiente
# Copie para .env.local e preencha. Sem estas variáveis o app roda em MODO DEMONSTRAÇÃO
# (conta e progresso ficam só no navegador, via localStorage).

# Supabase (públicas por design: quem protege os dados é o Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública do site, usada no redirecionamento de confirmação de e-mail.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NUNCA coloque aqui com prefixo NEXT_PUBLIC_: service_role, chaves de pagamento,
# segredos de webhook ou chaves de IA. Esses valores serão usados só no servidor
# numa fase futura (ex.: SUPABASE_SERVICE_ROLE_KEY, PAYMENT_WEBHOOK_SECRET).
