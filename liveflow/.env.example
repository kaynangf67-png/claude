# Sem estas variáveis o LiveFlow roda 100% em MODO DEMONSTRAÇÃO (dados no navegador).
# Com elas, usa Supabase (Auth + Postgres + Storage) de verdade.
# A anon key é pública por design: a segurança vem do RLS. NUNCA coloque a service_role key aqui.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# "remote" = usa a Edge Function ai-generate (Claude API, chave só no servidor).
# "local"  = gerador local baseado em templates + dados do usuário (sem custo, offline).
VITE_AI_MODE=local
