# =====================================================================
# Pele em Foco — variáveis de ambiente
# Tudo que começa com VITE_ vai para o código do navegador: NUNCA coloque segredos aqui.
# Segredos (service_role, webhook da Cakto) ficam só nos secrets das Edge Functions.
# =====================================================================

# ---- Backend (Supabase) ----
# Settings → API do seu projeto. A anon key é pública por design; quem protege os dados é o RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Modo demonstração (contas e dados só no navegador, sem segurança real).
# Em `npm run dev` sem Supabase ele liga sozinho. Em build de produção só liga com "true".
# Nunca use em produção com clientes reais.
VITE_DEMO_MODE=

# ---- Página de vendas ----
# Preço exibido (texto livre, ex.: "R$ 27,00")
VITE_PRICE_LABEL=
# Link da oferta na Cakto (Produtos → seu produto → Ver links), ex.: https://pay.cakto.com.br/abc123
VITE_CHECKOUT_URL=
# Prazo de reembolso em dias (mínimo legal: 7, art. 49 do CDC). O autoatendimento da Cakto
# (app.cakto.com.br/refund) aceita pedidos em até 7 dias; acima disso, o reembolso extra é pelo seu suporte.
VITE_REFUND_DAYS=7
# E-mail de suporte exibido no site e no app
VITE_SUPPORT_EMAIL=
# Responsável pela venda (rodapé e termos)
VITE_BUSINESS_NAME=
VITE_BUSINESS_DOCUMENT=
# URL pública do site
VITE_SITE_URL=

# ---- NÃO são VITE_: configure como secrets das Edge Functions (supabase secrets set ...) ----
# CAKTO_WEBHOOK_SECRET=   segredo devolvido pela Cakto ao criar o webhook
# CAKTO_PRODUCT_ID=       id do produto na Cakto (ignora eventos de outros produtos)
# APP_ORIGIN=             https://seu-dominio (CORS da função delete-account)
# SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY já existem automaticamente nas Edge Functions.
