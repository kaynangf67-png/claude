# Pele em Foco — configuração de lançamento.
# Todas as variáveis VITE_* vão para o código do navegador: NUNCA coloque segredos aqui.
# Campos vazios aparecem no site como "a configurar" (de propósito, para ninguém publicar sem preencher).

# Preço exibido na página de vendas (texto livre, ex.: "R$ 27,00")
VITE_PRICE_LABEL=
# Link do checkout da plataforma (Hotmart, Kiwify, Cakto, Eduzz...). Sem ele, o botão de compra fica desativado.
VITE_CHECKOUT_URL=
# Último dia do acesso gratuito ao app para compradores (AAAA-MM-DD)
VITE_BONUS_END_DATE=
# Prazo de reembolso em dias (mínimo legal para compras online: 7 dias, art. 49 do CDC)
VITE_REFUND_DAYS=7
# E-mail de suporte exibido no site
VITE_SUPPORT_EMAIL=
# Dados do responsável pela venda (exibidos no rodapé e nos termos)
VITE_BUSINESS_NAME=
VITE_BUSINESS_DOCUMENT=
# URL pública do site (usada em textos e no e-mail de entrega)
VITE_SITE_URL=
