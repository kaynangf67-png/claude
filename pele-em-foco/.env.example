# Pele em Foco — configuração de lançamento.
# Todas as variáveis VITE_* vão para o código do navegador: NUNCA coloque segredos aqui.
# Campos vazios aparecem no site como "a configurar" (de propósito, para ninguém publicar sem preencher).

# Preço exibido na página de vendas (texto livre, ex.: "R$ 27,00")
VITE_PRICE_LABEL=
# Link da oferta na Cakto (Produtos → seu produto → Ver links), ex.: https://pay.cakto.com.br/abc123
# Sem ele, o botão de compra fica desativado.
VITE_CHECKOUT_URL=
# Como a Cakto entrega o PDF: "email" (padrão) ou "members" (área de membros Cakto Members).
# Precisa ser igual ao canal de entrega escolhido no produto da Cakto; muda os textos de /obrigado e do FAQ.
VITE_CAKTO_DELIVERY=email
# Último dia do acesso gratuito ao app para compradores (AAAA-MM-DD)
VITE_BONUS_END_DATE=
# Prazo de reembolso em dias (mínimo legal: 7, art. 49 do CDC). O autoatendimento da Cakto
# (app.cakto.com.br/refund) aceita pedidos em até 7 dias; acima disso, o reembolso extra é pelo seu suporte.
VITE_REFUND_DAYS=7
# E-mail de suporte exibido no site
VITE_SUPPORT_EMAIL=
# Dados do responsável pela venda (exibidos no rodapé e nos termos)
VITE_BUSINESS_NAME=
VITE_BUSINESS_DOCUMENT=
# URL pública do site (usada em textos e no e-mail de entrega)
VITE_SITE_URL=
