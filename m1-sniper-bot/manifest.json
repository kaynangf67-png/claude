{
  "manifest_version": 3,
  "name": "M1 SNIPER BOT",
  "version": "1.5.2",
  "description": "Painel M1 sobre o gráfico da Quotex: lê o preço ao vivo da tela (inclui OTC), EMA/RSI/ADX/Bollinger/Price Action, gestão de risco e AUTO opcional.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "M1 SNIPER BOT — mostrar/ocultar painel no gráfico",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "src/background/sw.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://data-api.binance.vision/*",
    "https://api.binance.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://qxbroker.com/*",
        "https://*.qxbroker.com/*",
        "https://quotex.com/*",
        "https://*.quotex.com/*",
        "https://quotex.io/*",
        "https://*.quotex.io/*",
        "https://market-qx.pro/*",
        "https://*.market-qx.pro/*",
        "https://market-qx.trade/*",
        "https://*.market-qx.trade/*"
      ],
      "js": [
        "src/content/loader.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "options_page": "src/options/options.html"
}