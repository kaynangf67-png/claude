# Copie para .env.local. Variáveis VITE_* vão para o navegador: NUNCA coloque segredos aqui.
# Sem estas duas variáveis o app roda em MODO DEMONSTRAÇÃO (dados só no navegador, sem IA).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# URL pública usada nos links e QR Codes (sem barra no fim). Padrão: o domínio onde o app está aberto.
VITE_PUBLIC_BASE_URL=

# Segredos da Edge Function (configure com `supabase secrets set`, nunca aqui):
#   ANTHROPIC_API_KEY=sk-ant-...
#   AI_MODEL=claude-opus-5-5          (opcional)
#   AI_DAILY_IMAGE_LIMIT=60           (opcional)
