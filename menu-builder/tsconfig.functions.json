{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "npm:@anthropic-ai/sdk": ["./node_modules/@anthropic-ai/sdk"],
      "npm:@supabase/supabase-js@2": ["./node_modules/@supabase/supabase-js"]
    }
  },
  "include": ["supabase/functions/**/*.ts"],
  "exclude": ["supabase/functions/**/*.test.ts"]
}
