# ---- Backend (FastAPI) ----
# PostgreSQL em produção; sem isso usa SQLite local.
DATABASE_URL=postgresql+psycopg://trade_ai:trade_ai@localhost:5432/trade_ai
APP_TIMEZONE=America/Sao_Paulo
CORS_ORIGINS=http://localhost:5173

# Cripto (Binance, dados públicos, sem chave). Se receber HTTP 451, troque a URL:
BINANCE_ENABLED=true
BINANCE_BASE_URL=https://api.binance.com
# BINANCE_BASE_URL=https://data-api.binance.vision
BINANCE_MAX_SYMBOLS=60

# Forex, ações EUA, índices e commodities (Twelve Data). Sem chave = desligado.
TWELVEDATA_API_KEY=
TWELVEDATA_SYMBOLS=forex:EUR/USD,forex:GBP/USD,forex:USD/JPY,us_stocks:AAPL,us_stocks:NVDA,indices:SPX,commodities:XAU/USD
TWELVEDATA_CREDITS_PER_MINUTE=8

# Webhook do TradingView (B3, futuros e qualquer ativo do seu TradingView). Sem segredo = desligado.
TRADINGVIEW_WEBHOOK_SECRET=

# Leitura de capturas de gráfico (Claude). Sem chave = desligado.
ANTHROPIC_API_KEY=
VISION_MODEL=claude-opus-5-5

# Feed sintético para desenvolvimento. Sempre rotulado como SIMULADO.
ENABLE_SIMULATED_FEED=false
SCAN_INTERVAL_S=10

# ---- Frontend (Vite) ----
# Vazio = mesmo domínio (proxy do Vite em dev). Em deploy separado, a URL do backend.
VITE_API_URL=
VITE_ACCOUNT_CURRENCY=BRL
