{
  "manifest_version": 3,
  "name": "Sinal Honesto",
  "version": "1.9.0",
  "description": "Painel de sinais M1 por cima de qualquer corretora, com taxa de acerto real. Não opera sozinho.",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Abrir / fechar o Sinal Honesto nesta aba",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "Abrir / fechar o painel"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "sinais.html",
        "sinais.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}