# Copie para .env.local e preencha só o que for usar. Nenhuma chave vai no código.

# Centro padrão quando o GPS não está disponível (padrão: Vitória-ES)
VITE_DEFAULT_LAT=-20.3155
VITE_DEFAULT_LON=-40.2976

# Mapa de fundo por tema (estilos MapLibre). Padrão: OpenFreeMap liberty (claro) e dark (escuro), grátis e sem chave.
VITE_MAP_STYLE_LIGHT=
VITE_MAP_STYLE_DARK=

# Servidor de rotas OSRM para a navegação dentro do app.
# Padrão: servidor público de demonstração (router.project-osrm.org) — só para testes; em produção hospede o seu.
VITE_ROUTER_URL=

# Servidores Overpass (ruas do OpenStreetMap), separados por vírgula
VITE_OVERPASS_URLS=

# Busca de endereços (Photon). Para produção com volume, hospede um Photon próprio.
VITE_GEOCODER_URL=

# OpenRouteService — tempo de viagem por rota real (sem chave: estimativa pela distância)
VITE_ORS_KEY=

# Supabase — relatos compartilhados entre motoristas + login com Google
# (sem isto o app funciona só neste aparelho, com relatos simulados opcionais)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Link de checkout da assinatura (Asaas / Mercado Pago / Stripe). Vazio = lista de espera.
VITE_CHECKOUT_URL=
VITE_PRO_PRICE=R$ 9,90/mês

# ---- Voz humanizada da navegação (variáveis do SERVIDOR: configure no Vercel, sem o prefixo VITE_) ----
# Google Cloud Text-to-Speech (1 milhão de caracteres/mês grátis nas vozes Chirp 3 HD)
# GOOGLE_TTS_API_KEY=
# GOOGLE_TTS_VOICE=pt-BR-Chirp3-HD-Aoede
# ou ElevenLabs
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
