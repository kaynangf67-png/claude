# TRADE AGENT 2x0 — variáveis de ambiente (copie para .env; NUNCA faça commit do .env)
# Segredos reais vão só no provedor (Vercel/Render/Fly/VPS), nunca no chat nem no código.

# Modo de operação. Só DEMO é aceito nesta versão: REAL faz o sistema recusar a inicialização.
TRADING_MODE=DEMO

# PostgreSQL (ex.: Supabase). Formato: postgresql://usuario:SENHA@host:porta/banco
DATABASE_URL=

# Risco planejado por operação em BRL (máximo 5).
RISK_PER_TRADE_BRL=5

# Bloquear entradas perto de notícia de alto impacto (true/false).
BLOCK_HIGH_IMPACT_NEWS=true

# Segredo compartilhado com o Expert Advisor (Fase 4). Gere um valor longo e aleatório.
EA_SHARED_SECRET=

# Telegram (Fase 7, opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
